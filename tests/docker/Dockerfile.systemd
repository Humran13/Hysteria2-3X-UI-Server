# Disposable "fresh VPS": a base OS image + systemd + only what a minimal cloud image ships (curl, ca-certificates, iproute2).
# jq/openssl are deliberately NOT installed: the installer must pull its own dependencies.
ARG BASE=ubuntu:24.04
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive container=docker
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv dbus curl ca-certificates iproute2 sudo procps needrestart \
    && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
